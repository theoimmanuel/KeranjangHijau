# Salin file ini menjadi .env lalu ganti nilainya. File .env TIDAK boleh di-commit.
POSTGRES_USER=keranjanghijau
POSTGRES_PASSWORD=ganti-dengan-password-lokal
POSTGRES_DB=keranjanghijau
# Ganti jika port 5432 sudah dipakai PostgreSQL lain di komputer Anda (mis. 5433).
POSTGRES_PORT=5432

# Connection URI untuk psql dan scripts/reset-db.*; samakan dengan nilai di atas.
# Aplikasi juga membaca baris KH_* dari file .env ini (KH_DB -> Database:ConnectionString).
KH_DB=postgresql://keranjanghijau:ganti-dengan-password-lokal@localhost:5432/keranjanghijau

# API key RajaOngkir (Komerce) untuk cek resi -> CourierApi:ApiKey.
# Kosongkan jika ingin selalu memakai data mock (MockData/mock-resi.json).
KH_CourierApi__ApiKey=ISI_API_KEY_RAJAONGKIR
